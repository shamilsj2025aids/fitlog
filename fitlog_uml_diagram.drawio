<mxfile host="app.diagrams.net" modified="2026-09-29T00:00:00.000Z" agent="Antigravity AI" version="24.7.17"><diagram id="page_domain_model" name="1. Domain Entity Class Diagram (ERD)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1250" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_101" value="&lt;div style='font-size:22px;font-weight:bold;color:#1e293b;padding-bottom:4px;'&gt;FitLog — JPA Entity &amp; Domain Class Diagram&lt;/div&gt;&lt;div style='font-size:13px;color:#64748b;'&gt;Domain Model showing Object-Relational Mapping (ORM), Multiplicities, Attributes, Data Types &amp; Lifecycle Hooks&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1200" height="60" as="geometry" /></mxCell><mxCell id="group_102" value="&lt;b&gt;Core Persistence Entities (@Entity, @Table)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1150" height="1080" as="geometry" /></mxCell><mxCell id="group_103" value="&lt;b&gt;Domain Dictionaries &amp; Architecture Rules&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="350" height="1080" as="geometry" /></mxCell><mxCell id="UserEntity" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;Entity | table: users&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;User&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- id : Long {PK, @GeneratedValue}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- name : String {100, @NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- email : String {100, UNIQUE, @Email}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- age : Integer {@Min(1)}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weightKg : Double {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- heightCm : Double {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- gender : String {20}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- createdAt : LocalDateTime {@CreationTimestamp}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- workouts : List&amp;lt;Workout&amp;gt; {Cascade.ALL, LAZY}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- meals : List&amp;lt;Meal&amp;gt; {Cascade.ALL, LAZY}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- goals : List&amp;lt;Goal&amp;gt; {Cascade.ALL, LAZY}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ onCreate() : void {@PrePersist}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getId() : Long / setId(Long)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getName() : String / setName(String)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getEmail() : String / setEmail(String)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getWorkouts() : List&amp;lt;Workout&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getMeals() : List&amp;lt;Meal&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getGoals() : List&amp;lt;Goal&amp;gt;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="310" height="420" as="geometry" /></mxCell><mxCell id="WorkoutEntity" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dcfce7;border-bottom:1.5px solid #22c55e;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;Entity | table: workouts&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;Workout&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #22c55e;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- id : Long {PK, @GeneratedValue}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- user : User {FK user_id, LAZY, NOT NULL}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- workoutType : String {100, @NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- durationMinutes : Integer {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- caloriesBurnt : Double {@Min(0)}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- workoutDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- notes : String {500}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- loggedAt : LocalDateTime {NOT NULL}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ onCreate() : void {@PrePersist}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getId() : Long / setId(Long)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getUser() : User / setUser(User)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getWorkoutType() : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getDurationMinutes() : Integer&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getCaloriesBurnt() : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getWorkoutDate() : LocalDate&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#22c55e;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="310" height="320" as="geometry" /></mxCell><mxCell id="MealEntity" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffedd5;border-bottom:1.5px solid #f97316;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;Entity | table: meals&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;Meal&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #f97316;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- id : Long {PK, @GeneratedValue}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- user : User {FK user_id, LAZY, NOT NULL}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- foodItem : String {150, @NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- mealType : String {50, @NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- quantity : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- calories : Double {@Min(0), NOT NULL}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- mealDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- loggedAt : LocalDateTime {NOT NULL}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ onCreate() : void {@PrePersist}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getId() : Long / setId(Long)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getUser() : User / setUser(User)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getFoodItem() : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getMealType() : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getCalories() : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getMealDate() : LocalDate&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#f97316;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="310" height="320" as="geometry" /></mxCell><mxCell id="GoalEntity" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#f3e8ff;border-bottom:1.5px solid #a855f7;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;Entity | table: goals&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;Goal&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #a855f7;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- id : Long {PK, @GeneratedValue}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- user : User {FK user_id, LAZY, NOT NULL}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- targetWorkoutCount : Integer {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weekStartDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weekEndDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- status : String {30, &amp;#x27;ACTIVE&amp;#x27;}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- createdAt : LocalDateTime {NOT NULL}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ onCreate() : void {@PrePersist}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getId() : Long / setId(Long)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getUser() : User / setUser(User)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getTargetWorkoutCount() : Integer&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getWeekStartDate() : LocalDate&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getWeekEndDate() : LocalDate&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getStatus() : String&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#a855f7;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="850" width="310" height="310" as="geometry" /></mxCell><mxCell id="edge_104" value="1   ───   0..*&#10;(OneToMany: workouts)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e293b;strokeWidth=1.5;startArrow=diamond;startFill=1;endArrow=classic;endFill=1;startSize=14;fontSize=11;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="UserEntity" target="WorkoutEntity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_105" value="1   ───   0..*&#10;(OneToMany: meals)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e293b;strokeWidth=1.5;startArrow=diamond;startFill=1;endArrow=classic;endFill=1;startSize=14;fontSize=11;exitX=1.0;exitY=0.55;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="UserEntity" target="MealEntity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge_106" value="1   ───   0..*&#10;(OneToMany: goals)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e293b;strokeWidth=1.5;startArrow=diamond;startFill=1;endArrow=classic;endFill=1;startSize=14;fontSize=11;exitX=1.0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="UserEntity" target="GoalEntity"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="WorkoutTypesBox" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;Workout Categories&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;Domain Values&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• RUNNING&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• CYCLING&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• SWIMMING&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• WEIGHTLIFTING&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• YOGA&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• HIIT&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• WALKING&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="180" height="160" as="geometry" /></mxCell><mxCell id="edge_107" value="categorized by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;fontSize=11;exitX=1.0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="WorkoutEntity" target="WorkoutTypesBox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="MealTypesBox" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;Meal Types&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;Domain Values&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• BREAKFAST&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• LUNCH&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• DINNER&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• SNACK&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="920" y="530" width="180" height="120" as="geometry" /></mxCell><mxCell id="edge_108" value="classified by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;fontSize=11;exitX=1.0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="MealEntity" target="MealTypesBox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GoalStatusBox" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;Goal Statuses&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;Domain Values&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• ACTIVE&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• IN_PROGRESS&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• COMPLETED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#d8b4fe;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="920" y="880" width="180" height="110" as="geometry" /></mxCell><mxCell id="edge_109" value="state machine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;dashed=1;endArrow=open;endFill=0;fontSize=11;exitX=1.0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GoalEntity" target="GoalStatusBox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note_110" value="&lt;div style='font-size:11px;color:#475569;line-height:1.4;'&gt;&lt;b&gt;JPA Relationship Architecture&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Bidirectional OneToMany&lt;/b&gt;: User owns parent lifecycle; Workout, Meal, Goal hold foreign key &lt;code&gt;user_id&lt;/code&gt;.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;CascadeType.ALL&lt;/b&gt;: Deleting a User profile cascades and cleanly purges all workouts, meals, and goals.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;orphanRemoval = true&lt;/b&gt;: Disassociated child entries are deleted automatically.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;FetchType.LAZY&lt;/b&gt;: Child collections are loaded on demand to prevent N+1 query performance hits.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#eff6ff;strokeColor=#bfdbfe;size=14;shadow=1;align=left;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="310" height="230" as="geometry" /></mxCell><mxCell id="note_111" value="&lt;div style='font-size:11px;color:#475569;line-height:1.4;'&gt;&lt;b&gt;Business Rules &amp; Constraints&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Unique Email&lt;/b&gt;: Enforced via DB unique index and &lt;code&gt;UserRepository.existsByEmail()&lt;/code&gt;.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Calorie Non-Negativity&lt;/b&gt;: Calories consumed &amp; burnt cannot be negative (&lt;code&gt;@Min(0)&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Duration &amp; Goals&lt;/b&gt;: Must be strictly &gt; 0 (&lt;code&gt;@Positive&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Auto 7-Day Window&lt;/b&gt;: Goals automatically calculate &lt;code&gt;weekEndDate = weekStartDate + 6 days&lt;/code&gt; if omitted.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fefce8;strokeColor=#fef08a;size=14;shadow=1;align=left;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="310" height="240" as="geometry" /></mxCell><mxCell id="note_112" value="&lt;div style='font-size:11px;color:#475569;line-height:1.4;'&gt;&lt;b&gt;Serialization &amp; JSON Safety&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;@JsonIgnore &amp; @JsonIgnoreProperties&lt;/b&gt;: Used on child-to-parent backreferences to prevent infinite JSON recursive loops.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;DTO Decoupling&lt;/b&gt;: External clients never receive raw Hibernate proxies; responses are mapped to dedicated DTO records.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ecfdf5;strokeColor=#a7f3d0;size=14;shadow=1;align=left;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1260" y="670" width="310" height="200" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page_layered_arch" name="2. 3-Tier Layered Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1500" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_101" value="&lt;div style='font-size:22px;font-weight:bold;color:#1e293b;padding-bottom:4px;'&gt;FitLog — Full 3-Tier Layered Spring Boot Architecture&lt;/div&gt;&lt;div style='font-size:13px;color:#64748b;'&gt;Presentation (REST Controllers) ➔ Business Logic (Services) ➔ Data Access (JPA Repositories) ➔ Database &amp; AI Cloud&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1500" height="60" as="geometry" /></mxCell><mxCell id="group_102" value="&lt;b&gt;1. Presentation Layer (Spring REST Controllers &amp; OpenAPI Endpoints)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1920" height="240" as="geometry" /></mxCell><mxCell id="group_103" value="&lt;b&gt;2. Business Logic Layer (Service Interfaces &amp; Implementations)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#faf5ff;strokeColor=#d8b4fe;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="1920" height="520" as="geometry" /></mxCell><mxCell id="group_104" value="&lt;b&gt;3. Data Access Layer (Spring Data JPA Repositories)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="1920" height="230" as="geometry" /></mxCell><mxCell id="group_105" value="&lt;b&gt;4. Persistence &amp; External Integrations Tier&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="1920" height="260" as="geometry" /></mxCell><mxCell id="ctrl_0" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;UserController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/users&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ createUser()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getUserById()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getAllUsers()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ updateUser()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ deleteUser()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_1" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;WorkoutController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/workouts&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ logWorkout()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getWorkoutById()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getByUserId()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ filterWorkouts()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ deleteWorkout()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="355" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_2" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;MealController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/meals&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ logMeal()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getMealById()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getByUserId()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ filterMeals()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ deleteMeal()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_3" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;GoalController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/goals&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ setWeeklyGoal()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getActiveGoal()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getByUserId()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ updateGoal()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ deleteGoal()&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="885" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_4" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;SummaryController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/summaries&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getDailySummary()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getWeeklyTrend()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;(Calorie In/Out)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;(Workout Progress)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_5" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;DashboardController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/dashboard&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ getOverview()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;(Total metrics)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;(Users, Workouts,&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;Meals, Goals)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1415" y="140" width="240" height="180" as="geometry" /></mxCell><mxCell id="ctrl_6" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;ChatController&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;@RestController&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;/api/chat&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ askCoach()&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;+ streamCoach() [SSE]&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155