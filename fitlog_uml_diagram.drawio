metry" /></mxCell><mxCell id="dto_dash_res" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dcfce7;border-bottom:1.5px solid #22c55e;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | System Metrics&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;DashboardOverviewResponse&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #22c55e;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalRegisteredUsers : Long&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalWorkoutsLogged : Long&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalMealsLogged : Long&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalCaloriesBurnt : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalCaloriesConsumed : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- activeGoalsCount : Long&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#22c55e;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="790" width="500" height="190" as="geometry" /></mxCell><mxCell id="dto_chat_res" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;backgr