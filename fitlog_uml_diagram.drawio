;recursiveResize=0;outlineConnect=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;size=40;fontFamily=Helvetica;fontSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1540" y="120" width="160" height="950" as="geometry" /></mxCell><mxCell id="msg_102" value="1. POST /api/workouts (WorkoutRequest JSON)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_client" target="lf_ctrl"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="200" as="sourcePoint" /><mxPoint x="0" y="200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_103" value="2. Validate payload (@Valid annotations)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_ctrl" target="lf_ctrl"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="240" as="sourcePoint" /><mxPoint x="0" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_104" value="3. logWorkout(WorkoutRequest)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_ctrl" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="280" as="sourcePoint" /><mxPoint x="0" y="280" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_105" value="4. findById(request.getUserId())" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_urepo"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="330" as="sourcePoint" /><mxPoint x="0" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_106" value="5. return Optional&lt;User&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_urepo" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="380" as="sourcePoint" /><mxPoint x="0" y="380" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_107" value="6. Validate User exists &amp; Map DTO -&gt; Workout" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="430" as="sourcePoint" /><mxPoint x="0" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_108" value="7. save(workoutEntity)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_wrepo"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="480" as="sourcePoint" /><mxPoint x="0" y="480" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_109" value="8. return persisted Workout (with ID)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_wrepo" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="530" as="sourcePoint" /><mxPoint x="0" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_110" value="9. findActiveGoalForUser(userId, workoutDate)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_grepo"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="590" as="sourcePoint" /><mxPoint x="0" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_111" value="10. return Optional&lt;Goal&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_grepo" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="640" as="sourcePoint" /><mxPoint x="0" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_112" value="11. countByUserIdAndWorkoutDateBetween(startDate, endDate)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_wrepo"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="700" as="sourcePoint" /><mxPoint x="0" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_113" value="12. return completedWorkoutCount : Long" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_wrepo" target="lf_svc"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="750" as="sourcePoint" /><mxPoint x="0" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_114" value="13. if (count &gt;= target) update goal status = 'COMPLETED'" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_grepo"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="810" as="sourcePoint" /><mxPoint x="0" y="810" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_115" value="14. return WorkoutResponse" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_svc" target="lf_ctrl"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="870" as="sourcePoint" /><mxPoint x="0" y="870" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg_116" value="15. HTTP 201 CREATED (WorkoutResponse JSON)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#64748b;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" edge="1" parent="1" source="lf_ctrl" target="lf_client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="920" as="sourcePoint" /><mxPoint x="0" y="920" as="targetPoint" /></mxGeometry></mxCell><mxCell id="note_117" value="&lt;div style='font-size:11px;color:#475569;line-height:1.4;'&gt;&lt;b&gt;Core Architecture Takeaway&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Synchronous Verification&lt;/b&gt;: When a user logs an activity, the service immediately evaluates progress against weekly goals.&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Transactional Boundaries&lt;/b&gt;: The entire log + goal update flow runs within Spring's transactional boundary (&lt;code&gt;@Transactional&lt;/code&gt;).&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Exception Flow&lt;/b&gt;: If user ID does not exist, &lt;code&gt;ResourceNotFoundException&lt;/code&gt; is thrown and caught by &lt;code&gt;GlobalExceptionHandler&lt;/code&gt;, returning HTTP 404.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8fafc;strokeColor=#cbd5e1;size=14;shadow=1;align=left;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="100" y="1080" width="800" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page_dto_contracts" name="4. DTO &amp; API Contracts Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1350" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_101" value="&lt;div style='font-size:22px;font-weight:bold;color:#1e293b;padding-bottom:4px;'&gt;FitLog — Data Transfer Object (DTO) &amp; API Contract Architecture&lt;/div&gt;&lt;div style='font-size:13px;color:#64748b;'&gt;Decoupling REST Inbound / Outbound Payloads from Database JPA Entities for Security, Clean Serialization &amp; Validation&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1500" height="60" as="geometry" /></mxCell><mxCell id="group_102" value="&lt;b&gt;Client Requests (@RequestBody DTOs)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="520" height="1180" as="geometry" /></mxCell><mxCell id="group_103" value="&lt;b&gt;Processing &amp; Mapping Core (Controllers &amp; Services)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="520" height="1180" as="geometry" /></mxCell><mxCell id="group_104" value="&lt;b&gt;API Responses (Output DTOs &amp; Summaries)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;dashed=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;arcSize=8;shadow=0;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="580" height="1180" as="geometry" /></mxCell><mxCell id="dto_user_req" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Inbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;UserRequest&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- name : String {@NotBlank, 100}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- email : String {@Email, @NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- age : Integer {@Min(1)}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weightKg : Double {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- heightCm : Double {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- gender : String&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="460" height="180" as="geometry" /></mxCell><mxCell id="dto_workout_req" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Inbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;WorkoutRequest&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- userId : Long {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- workoutType : String {@NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- durationMinutes : Integer {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- caloriesBurnt : Double {@Min(0)}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- workoutDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- notes : String {500}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="460" height="180" as="geometry" /></mxCell><mxCell id="dto_meal_req" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Inbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;MealRequest&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- userId : Long {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- foodItem : String {@NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- mealType : String {@NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- quantity : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- calories : Double {@Min(0)}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- mealDate : LocalDate {@NotNull}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="460" height="180" as="geometry" /></mxCell><mxCell id="dto_goal_req" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Inbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;GoalRequest&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- userId : Long {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- targetWorkoutCount : Integer {@Positive}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weekStartDate : LocalDate {@NotNull}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weekEndDate : LocalDate&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="800" width="460" height="170" as="geometry" /></mxCell><mxCell id="dto_chat_req" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dbeafe;border-bottom:1.5px solid #3b82f6;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Inbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;ChatRequest&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #3b82f6;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- message : String {@NotBlank}&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- userId : Long (Optional for user context)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#3b82f6;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="1010" width="460" height="140" as="geometry" /></mxCell><mxCell id="core_map_box" value="&lt;div style='text-align:center;'&gt;&lt;div style='font-weight:bold;font-size:13px;color:#0f172a;'&gt;Spring Boot Mapping &amp;amp; Validation Boundary&lt;/div&gt;&lt;div style='font-size:10px;font-style:italic;color:#555;'&gt;&amp;laquo;Architecture Core&amp;raquo;&lt;/div&gt;&lt;/div&gt;&lt;div style='margin-top:4px;text-align:left;padding:0 6px;'&gt;&lt;span style='font-size:11px;color:#334155;'&gt;&amp;lt;b&amp;gt;1. Inbound Validation (@Valid)&amp;lt;/b&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Intercepts invalid input before hitting services&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Fires MethodArgumentNotValidException with 400 Bad Request&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;2. DTO ➔ Entity Conversion&amp;lt;/b&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Service layer constructs clean JPA entities&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Resolves foreign keys safely (e.g. userId ➔ User reference)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;3. Business Rule Enforcement&amp;lt;/b&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Checks duplicates, verifies calorie non-negativity&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Evaluates goal achievement progress&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;4. Entity ➔ DTO Response Mapping&amp;lt;/b&amp;gt;&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Strips sensitive DB columns and passwords&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Prevents Jackson infinite recursion loops (@JsonIgnore)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#334155;'&gt;• Formats calculated totals (Net calories, streaks)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;shadow=1;arcSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="460" height="520" as="geometry" /></mxCell><mxCell id="dto_user_res" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dcfce7;border-bottom:1.5px solid #22c55e;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Outbound Payload&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;UserResponse&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #22c55e;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- id : Long&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- name : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- email : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- age : Integer&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- weightKg : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- heightCm : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- gender : String&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- createdAt : LocalDateTime&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#22c55e;strokeWidth=1.5;fillColor=#ffffff;shadow=1;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="500" height="190" as="geometry" /></mxCell><mxCell id="dto_summary_res" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;'&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#dcfce7;border-bottom:1.5px solid #22c55e;text-align:center;'&gt;&lt;div style='font-size:11px;font-style:italic;color:#475569;'&gt;&amp;laquo;DTO | Calculated Analytics&amp;raquo;&lt;/div&gt;&lt;div style='font-size:13px;font-weight:bold;color:#0f172a;'&gt;DailySummaryResponse&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;border-bottom:1px solid #22c55e;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- date : LocalDate&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalCaloriesConsumed : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- totalCaloriesBurnt : Double&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- netCalories : Double (Consumed - Burnt)&lt;/span&gt;&lt;br/&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;- status : String (&amp;#x27;DEFICIT&amp;#x27; | &amp;#x27;SURPLUS&amp;#x27;)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:6px 8px;background:#ffffff;vertical-align:top;text-align:left;'&gt;&lt;span style='font-family:Courier New,monospace;font-size:11px;'&gt;+ getters() / setters()&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;overflow=fill;strokeColor=#22c55e;strokeWidth=1.5;fillColor